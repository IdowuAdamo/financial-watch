# FinancialWatch Environment Template
# Copy to .env for local development

# PostgreSQL 16 + pgvector database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/financial_watch

# Crawler compliance identification URL (points to repository with bot policy)
CRAWLER_CONTACT_URL=https://github.com/IdowuAdamo/financial-watch.git

# API Access Key for protected ingestion, review queue and analysis endpoints
API_ACCESS_KEY=fw-test-access-key-2026

# OpenAI API Key (replace with real sk-proj-... key for live LLM inference)
OPENAI_API_KEY=mock-api-key

# Target OpenAI Models
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
